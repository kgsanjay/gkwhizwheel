# ==============================================================================
# GK Whizwheel - Monorepo .gitignore (Laravel Backend + React Native Mobile)
# ==============================================================================

# Dependencies
/vendor/
/node_modules/
mobile/node_modules/

# Environment and Credentials
.env
.env.*
!.env.example
/auth.json
Homestead.json
Homestead.yaml

# Application Storage & Generated Caches
/storage/*.key
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/pail/
/public/storage

# Framework & Bootstrap Caches
bootstrap/cache/*.php
!bootstrap/cache/.gitignore

# Testing and PHPUnit
/.phpunit.cache/
.phpunit.result.cache

# Frontend Web Build Artifacts
/public/build/
/public/hot
build/

# Android Build Artifacts & Intermediate Outputs
.gradle/
**/android/.gradle/
**/android/build/
**/android/app/build/
**/android/**/build/
**/android/*.iml
**/android/app/*.iml
**/android/local.properties
**/android/.cxx/

# APK Handling Decision:
# Ignore intermediate/debug build APKs generated in build folders:
**/build/**/*.apk
**/build/**/*.aab
# NOTE: Final release distribution APKs placed in public/downloads/ (e.g. for
# /staff/app-version direct downloads per 05-ENVIRONMENT-SETUP.md) are NOT ignored.
!public/downloads/*.apk

# Local SQLite databases
database/*.sqlite
database/*.sqlite-journal
database/*.sqlite-shm
database/*.sqlite-wal

# Operating System & File Managers
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Editors
.idea/
.vscode/
.fleet/
.nova/
.zed/
*.sublime-project
*.sublime-workspace
.phpactor.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
